# Copy to .env (never commit the real file). All values are optional in development.

# REQUIRED in production: 32+ random characters (the server refuses to start without it)
JWT_SECRET=

# Where the JSON database and email outbox are written (defaults shown)
DB_FILE=data/db.json
OUTBOX_FILE=data/outbox.log

# Public address of the site (used in emails and payment return URLs)
PUBLIC_URL=http://localhost:5173

# PayFast (sandbox merchant details come from your sandbox.payfast.co.za account).
# notify_url must be reachable from the internet (e.g. an ngrok URL as PUBLIC_URL).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# SnapScan (needs a SnapScan merchant account)
SNAPSCAN_SNAPCODE=
SNAPSCAN_WEBHOOK_KEY=
SNAPSCAN_SANDBOX=true

# Production only: allow built-in "test mode" payments when no gateway is configured
ALLOW_SIMULATED_PAYMENTS=false
# Production only: keep the seeded demo logins (Demo@1234) working. Leave false for real use.
ALLOW_DEMO_ACCOUNTS=false
# Show the demo-account quick-fill buttons on the login screen of a production build
VITE_SHOW_DEMO_ACCOUNTS=false
